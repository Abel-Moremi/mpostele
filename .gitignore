# Obsidian vault metadata
.obsidian/
.obsidian/**

# Optional: if you use local temp or trash folders
.trash/

# Common OS/editor noise
.DS_Store
Thumbs.db

# Keep your actual notes tracked
# Do not ignore *.md files unless you intentionally want that.

# Python
__pycache__/
*.pyc

# Remotion (remotion/) - Node toolchain, install fresh via `npm install`
remotion/node_modules/
remotion/out/

# Generated job artifacts and local fonts/model assets
# (folder structure tracked via .gitkeep, contents ignored)
app/media/assets/jobs/*
!app/media/assets/jobs/.gitkeep
app/media/assets/tmp/*
!app/media/assets/tmp/.gitkeep
app/media/assets/output/*
!app/media/assets/output/.gitkeep
app/media/assets/fonts/*
!app/media/assets/fonts/.gitkeep
