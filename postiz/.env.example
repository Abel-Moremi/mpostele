# Copy this file to .env (same directory) and fill it in.
# .env itself is gitignored - never commit real secrets.

# Required. Generate a unique random string, e.g.:
#   openssl rand -hex 32
POSTIZ_JWT_SECRET=

# Optional. Change only if 4007 is already in use on this machine.
POSTIZ_PORT=4007

# Optional - only needed to connect that platform's account. Each requires
# your own developer app registered with that platform (self-hosted
# instances don't get Postiz's own hosted app credentials):
#   X (Twitter):   https://developer.x.com
#   LinkedIn:      https://www.linkedin.com/developers/apps
#   TikTok:        https://developers.tiktok.com
#   Instagram:     https://developers.facebook.com (Meta app; see below)
X_API_KEY=
X_API_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# Instagram "Standalone" - simplest path for a single account, no linked
# Facebook Page required. Use the Instagram App ID/Secret from your Meta
# app's Instagram product (not the app's main App ID).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Instagram "Business" - alternative that needs a Facebook Page linked to
# the Instagram account. Leave blank unless you want this instead of
# Standalone above.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
